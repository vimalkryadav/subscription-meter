{
    admin off
    auto_https off
}

:8182 {
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }
    handle / {
        root * /srv
        file_server
    }
    handle /manage {
        root * /srv
        rewrite * /manage.html
        file_server
    }
    handle /portal/api/* {
        request_body {
            max_size 16KB
        }
        reverse_proxy app:8180
    }
    handle /admin/* {
        reverse_proxy app:8180
    }
    @messages {
        method POST
        path /gateway/v1/messages /gateway/v1/messages/count_tokens
    }
    @models {
        method GET
        path /gateway/v1/models
    }
    handle @messages {
        uri strip_prefix /gateway
        reverse_proxy app:8180 {
            flush_interval -1
        }
    }
    handle @models {
        uri strip_prefix /gateway
        reverse_proxy app:8180
    }
    handle {
        respond "Not found" 404
    }
}

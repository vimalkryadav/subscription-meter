{
    admin off
    auto_https off
}

:8182 {
    @messages {
        method POST
        path /v1/messages /v1/messages/count_tokens
    }
    @models {
        method GET
        path /v1/models
    }
    handle @messages {
        reverse_proxy app:8180 {
            flush_interval -1
        }
    }
    handle @models {
        reverse_proxy app:8180
    }
    handle {
        respond "Not found" 404
    }
}

[Unit]
Description=Collect local control-usage operational health
After=docker.service

[Service]
Type=oneshot
User=coder
WorkingDirectory=/home/coder/control-usage-deploy
Environment=CONTROL_USAGE_RUNTIME_ROOT=/home/coder/subscription-meter
ExecStart=/usr/bin/python3 /home/coder/control-usage-deploy/scripts/monitor_operations.py
TimeoutStartSec=50
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/coder/control-usage-deploy/deploy/operations

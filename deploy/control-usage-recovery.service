[Unit]
Description=Bounded control-usage health review and known-failure recovery
After=docker.service control-usage-monitor.service

[Service]
Type=oneshot
User=coder
WorkingDirectory=/home/coder/control-usage-deploy
Environment=CONTROL_USAGE_DOCKER_SUDO=1
Environment=CONTROL_USAGE_RUNTIME_ROOT=/home/coder/subscription-meter
ExecStart=/usr/bin/python3 /home/coder/control-usage-deploy/scripts/hourly_recovery.py
TimeoutStartSec=180
UMask=0077

[Unit]
Description=Collect control-usage backup capacity metadata
After=docker.service

[Service]
Type=oneshot
User=coder
WorkingDirectory=/home/coder/control-usage-deploy
Environment=CONTROL_USAGE_DOCKER_SUDO=1
Environment=CONTROL_USAGE_BACKUP_DIR=/home/coder/control-usage-backups
ExecStart=/usr/bin/python3 /home/coder/control-usage-deploy/scripts/backup_database.py --capacity
TimeoutStartSec=45
UMask=0077
Nice=10

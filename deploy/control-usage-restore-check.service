[Unit]
Description=Isolated control-usage database restore verification
After=docker.service control-usage-backup.service

[Service]
Type=oneshot
User=coder
WorkingDirectory=/home/coder/control-usage-deploy
Environment=CONTROL_USAGE_DOCKER_SUDO=1
Environment=CONTROL_USAGE_BACKUP_DIR=/home/coder/control-usage-backups
ExecStart=/usr/bin/python3 /home/coder/control-usage-deploy/scripts/backup_database.py --verify-latest
TimeoutStartSec=1200
UMask=0077
Nice=10
IOSchedulingClass=idle
